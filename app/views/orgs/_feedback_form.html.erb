<%# locals: org %>

<% title _('Request Feedback') %>
<%= form_for(org, url: admin_update_org_path(org),
                   html: { multipart: true, method: :put,
                           id: "edit_org_feedback_form" } ) do |f| %>
  <h2><%= _('Request Feedback') %></h2>
  <div class="row">
    <div class="radio col-xs-8">
      <%= f.label :feedback_enabled do %>
        <%= f.radio_button(:feedback_enabled, true) %>
        <%= _('On') %>
      <% end %>
      <%= f.label :feedback_enabled do %>
        <%= f.radio_button(:feedback_enabled, false) %>
        <%= _('Off') %>
      <% end %>
    </div>
  </div>
  <div id="feeback-email">
    <h3>
      <%= _('Request Expert Feedback - Message Displayed on Share Plan Tab:') %>
    </h3>
    <div class="row">
      <div class="form-group col-xs-8" data-html="true">
        <p>
          <%= _('You can personalise your request feedback message by including the following placeholders that will be replaced with real data:') %>
          <ul>
            <li><code class="code-darkest-yellow">%{user_name}</code> — <%= _('The name of the user submitting the feedback request') %></li>
            <li><code class="code-darkest-yellow">%{plan_name}</code> — <%= _('The name of the plan') %></li>
            <li><code class="code-darkest-yellow">%{organisation_email}</code> — <%= _('The contact email for your organisation') %></li>
          </ul>
          <strong><%= _('NOTE: Placeholders must be typed exactly as shown, including the %{...} format.') %></strong>
        </p>
        <%= f.label :feedback_msg, _('Message'), class: "control-label" %>
        <%= f.text_area :feedback_msg, class: "form-control", spellcheck: true,
                        "aria-required" => true %>
      </div>
      <div class="form-group col-xs-4">
        <h4><%= _('Sample Message') %></h4>
         <%= sanitize display_sample_feedback_message(org, current_user) %>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="form-group col-xs-8">
      <%= f.button(_('Save'), id:"save_org_submit", class: "btn btn-primary", type: "submit") %>
    </div>
  </div>
<% end %>
