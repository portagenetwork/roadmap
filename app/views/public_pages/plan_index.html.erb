<div class="row">
  <div class="col-md-12">
     <h1><%= _('Example DMPs') %></h1>
      <p class="left-indent">
        <%= _('Below are publicly available example Data Management Plans that can help guide the development of your own DMP.') %>
      </p>
      
    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th><%= _('Example Data Management Plans') %></th>
        </tr>
      </thead>
      <tbody>
        <% example_dmps.each do |dmp| %>
          <tr>
            <td>
              <%= link_to dmp[:title], dmp[:url], target: "_blank", rel: "noopener" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>