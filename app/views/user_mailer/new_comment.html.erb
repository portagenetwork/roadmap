<p>
  <%= _('Hello %{user_name}') %{ user_name: @user_name } %>
</p>
<p>
  <%= _('%{commenter_name} has commented on your plan %{plan_title}. To view the comments, '\
  'follow the link to the DMP below, or navigate to the plan via My Dashboard page in %{tool_name}.') \
  %{ commenter_name: @commenter_name, plan_title: @plan_title, tool_name: tool_name } %>
</p>
<p>
  <%=  _('Below is a summary of the sections and questions which have comments.') %>
  <%= _('You can see the comments in the right-hand panel, '\
    'adjacent to the guidance for each question.') %>
</p>
<p>
  <%= _('DMP: %{phase_link}') %{ phase_link: @phase_link }  %>
</p>
<p>
  <%= _('Section name: %{section_title}') %{ section_title: @section_title } %>
</p>
<p>
  <%= _('Question: %{question_number}') %{ question_number: @question_number } %>
</p>
<%= render partial: 'email_signature' %>

<hr>
<p>
  <%= 'Bonjour %{user_name}' %{ user_name: @user_name } %>
</p>
<p>
  <%= '%{commenter_name} a effectué des commentaires sur votre plan %{plan_title}. Pour les afficher, '\
  'suivez le lien vers le PGD ci-dessous ou accédez au plan à partir de la page Mon tableau de bord dans %{tool_name}.' \
  %{ commenter_name: @commenter_name, plan_title: @plan_title, tool_name: tool_name } %>
</p>
<p>
  <%= 'Vous trouverez ci-dessous un résumé des sections et des questions associées à des commentaires.' %>
  <%= 'Vous pouvez voir les commentaires dans la partie de droite, '\
    'à côté des directives pour chaque question.' %>
</p>
<p>
  <%= 'PGD : %{phase_link}' %{ phase_link: @phase_link }  %>
</p>
<p>
  <%= 'Nom de la section: %{section_title}' %{ section_title: @section_title } %>
</p>
<p>
  <%= 'Question : %{question_number}' %{ question_number: @question_number } %>
</p>
<%= render partial: 'french_email_signature' %>

