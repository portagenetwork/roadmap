<%# locals: plan, snapshot_blockers %>
<% most_recent_snapshot = plan.snapshots.order(created_at: :desc).first %>
<% is_public = most_recent_snapshot&.publicly_visible? || false %>
<% disabled = snapshot_blockers.any? %>

<div class="mt-3">
  <button id="btn_toggle_snapshot_form" type="button" class="btn btn-primary" <%= 'disabled' if disabled %>>
    <%= _('Create a version of this DMP') %>
  </button>

  <% if disabled %>
    <div class="alert alert-warning mt-3">
      <p><%= _('Unable to create a version of this DMP. Please address the following:') %></p>
      <ul class="mb-0">
        <% snapshot_blockers.each do |b| %>
          <li><%= b %></li>
        <% end %>
      </ul>
    </div>
  <% else %>

    <div id="snapshot_creation_panel" class="card d-none my-3">
      <div class="card-body">
        <%= form_with url: plan_snapshots_path(plan), method: :post, local: true do |f| %>
          
          <div class="mb-3">
            <label class="form-label fw-bold mb-2">
              <%= _('Select the visibility level of your versioned plan') %>
            </label>

            <div class="form-check mb-2">
              <%= radio_button_tag 'plan_snapshot[visibility]',
                                    'privately_visible',
                                    !is_public,
                                    class: 'form-check-input',
                                    id: 'snapshot_visibility_private' %>
              <%= label_tag 'snapshot_visibility_private',
                            _('Private'),
                            class: 'form-check-label' %>
            </div>

            <div class="form-check">
              <%= radio_button_tag 'plan_snapshot[visibility]',
                                    'publicly_visible',
                                    is_public,
                                    class: 'form-check-input',
                                    id: 'snapshot_visibility_public' %>
              <%= label_tag 'snapshot_visibility_public',
                            _('Public with a DOI'),
                            class: 'form-check-label' %>
            </div>
          </div>

          <div id="snapshot_public_warning" class="alert alert-warning my-3 <%= 'd-none' unless is_public %>">
            <small><%= _('Minting a DOI creates a permanent public record. This action cannot be undone.') %></small>
          </div>

          <div class="d-flex align-items-center" style="gap: 10px;">
            <%= f.submit _('Confirm & Create Version'),
                class: 'btn btn-primary',
                id: 'create_snapshot_submit_btn' %>

            <button id="btn_cancel_snapshot" type="button" class="btn btn-secondary">
              <%= _('Cancel') %>
            </button>
          </div>

        <% end %>
      </div>
    </div>
  <% end %>
</div>
