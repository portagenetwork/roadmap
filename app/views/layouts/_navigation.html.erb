<nav id="app-navbar" class="navbar navbar-expand-md navbar-branding">
  <div class="container-fluid">
    <!-- Brand and toggle get grouped for better mobile display -->
    <%= link_to(image_tag(current_locale_logo,
                          alt: "#{ApplicationService.application_name} #{_('logo')}",
                          class: "app-logo",
                          title: ApplicationService.application_name),
                root_path, class: "navbar-brand") %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
      data-bs-target="#app-navbar-menu" aria-controls="app-navbar-menu" 
      aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collect the nav links, forms, and other content for toggling -->
    <div class="collapse navbar-collapse" id="app-navbar-menu">
      <ul class="navbar-nav me-auto gap-lg-3">
        <% if user_signed_in? %>
          <li class="nav-item <%= ' active' if active_page?(plans_path, true) %>">
            <%= link_to _('My Dashboard'), plans_path, class: 'nav-link' %>
          </li>
          <li class="nav-item <%= ' active' if active_page?(new_plan_path, true) %>">
            <%= link_to _('Create plan'), new_plan_path, class: 'nav-link', id: "create-plan-link" %>
          </li>
          <li class="dropdown nav-item <%= ' active' if active_page?(public_plans_path, true) || active_page?(public_templates_path, true) %>" id="reference-dropdown">
            <a href="#" class="dropdown-toggle nav-link" role="button" id="reference-menu" data-bs-toggle="dropdown" data-bs-display="static" aria-haspopup="true" aria-expanded="false">
              <i class="fas fa-book" aria-hidden="true">&nbsp;</i>
              <%= _("Reference") %>
            </a>
            <ul class="dropdown-menu inverse-dropdown dropdown-menu-end" aria-labelledby="reference-menu">
              <li class="nav-item <%= ' active' if active_page?(public_plans_path) %>">
                <%= link_to _('Example DMPs'), public_plans_path, class: 'dropdown-item px-3' %>
              </li>
              <li class="nav-item <%= ' active' if active_page?(public_templates_path) %>">
                <%= link_to _('DMP Templates'), public_templates_path, class: 'dropdown-item px-3' %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item <%= ' active' if active_page?(root_path, true) || active_page?(plans_path, true) %>">
            <%= link_to _('Home'), root_path, class: 'nav-link' %>
          </li>
          <li class="nav-item <%= ' active' if active_page?(public_plans_path, true) %>">
            <%= link_to _('Example DMPs'), public_plans_path, class: 'nav-link' %>
          </li>
          <li class="nav-item <%= ' active' if active_page?(public_templates_path, true) %>">
            <%= link_to _('DMP Templates'), public_templates_path, class: 'nav-link' %>
          </li>
        <% end %>
        <!-- help page -->
        <li class="nav-item <%= ' active' if active_page?(help_path, true) %>">
          <%= link_to _('Help'), help_path, class: 'nav-link' %>
        </li>
        <li class="nav-item <%= ' active' if active_page?(about_us_path, true) %>">
          <%= link_to _('About'), about_us_path, class: 'nav-link' %>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto gap-lg-3">
        <%= render "layouts/signin_signout" %>
      </ul>

    </div><!-- /.navbar-collapse -->
  </div><!-- /.container-fluid -->
</nav>