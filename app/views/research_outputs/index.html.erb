<% title sanitize(_("%{plan_title} - research outputs") % {plan_title: @plan.title}) %>



<div class="row">
  <div class="col-md-12">
    <!-- render the project title -->
    <h1><%= sanitize(@plan.title) %></h1>
  </div>
</div>

<% content_for :plan_tab_body do %>
  <% if @plan.administerable_by?(current_user.id) %>
    <div class="panel panel-default doi-lookup-section" style="margin-top: 20px; background-color: #f9f9f9; border-color: #ddd;">
      <div class="panel-body">
        <div class="form-group">
          <label for="doi_lookup_input" class="control-label">
            <%= _("Pre-fill with DOI") %>
          </label>
          <p class="help-block">
            <%= _("Enter a dataset or software DOI (e.g., 10.5281/zenodo.4884775) to automatically import its metadata into a new form.") %>
          </p>
          <div class="input-group" style="max-width: 500px;">
            <input type="text" id="doi_lookup_input" class="form-control" placeholder="10.xxxx/xxxxxx">
            <span class="input-group-btn">
              <button id="btn_fetch_doi" 
                      class="btn btn-default" 
                      type="button" 
                      data-plan-id="<%= @plan.id %>">
                <%= _("Fetch & Add") %>
              </button>
            </span>
          </div>
          <span id="doi_lookup_status" class="help-block hidden"></span>
        </div>
      </div>
    </div>
    <hr />
  <% end %>

  <div class="row">
    <div class="col-md-12">
      <p>
        <%= _("Please list your anticipated research output(s).") %>
      </p>
      <br/>

      <% if @research_outputs.any? %>
        <%= paginable_renderise partial: "/paginable/research_outputs/index",
                                controller: "paginable/research_outputs",
                                action: "index",
                                scope: @research_outputs,
                                locals: { plan: @plan },
                                query_params: {
                                  sort_field: 'research_outputs.title',
                                  sort_direction: :asc } %>
      <% end %>

      <% if @plan.administerable_by?(current_user.id) %>
        <%= link_to _("Add a research output"), new_plan_research_output_path(@plan),
                                            class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% end %>

<%= render partial: "plans/navigation", locals: { plan: @plan } %>
